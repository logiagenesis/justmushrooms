<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ shop.name }}</title>
  <style>{{ settings.type_display_font | font_face: font_display: 'swap' }}{{ settings.type_body_font | font_face: font_display: 'swap' }}{%- render 'css-tokens' -%}</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent" class="main" role="main">{{ content_for_layout }}</main>
</body>
</html>
