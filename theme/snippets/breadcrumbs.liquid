<nav aria-label="Breadcrumb">
  <ol class="crumbs">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    {%- case request.page_type -%}
      {%- when 'product' -%}
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li aria-current="page">{{ product.title }}</li>
      {%- when 'collection' -%}
        {%- if collection.handle == 'all' -%}<li aria-current="page">Shop</li>{%- else -%}<li><a href="{{ routes.all_products_collection_url }}">Shop</a></li><li aria-current="page">{{ collection.title }}</li>{%- endif -%}
      {%- when 'metaobject' -%}
        <li><a href="/pages/species">Species Library</a></li>
        <li aria-current="page">{{ metaobject.common_name.value }}</li>
      {%- when 'article' -%}
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li aria-current="page">{{ article.title | truncate: 60 }}</li>
      {%- when 'blog' -%}
        <li aria-current="page">{{ blog.title }}</li>
      {%- when 'page' -%}
        <li aria-current="page">{{ page.title }}</li>
    {%- endcase -%}
  </ol>
</nav>
{%- render 'schema-breadcrumb' -%}
