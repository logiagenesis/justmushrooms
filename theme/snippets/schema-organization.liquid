{%- liquid
  # Whichever social URLs the merchant filled in, as one list. Joining on '|' and splitting
  # again drops the blanks, so sameAs never emits a stray comma for an unset setting.
  assign social_raw = settings.social_instagram | append: '|' | append: settings.social_facebook | append: '|' | append: settings.social_tiktok | append: '|' | append: settings.social_youtube
  assign social_urls = social_raw | split: '|'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.biz_legal_name != blank -%}"legalName": {{ settings.biz_legal_name | json }},{%- endif -%}
      "email": {{ settings.biz_email | json }},
      "telephone": {{ settings.biz_phone | json }},
      "address": { "@type": "PostalAddress", "streetAddress": "77 Hoof Road", "addressLocality": "Plettenberg Bay", "addressRegion": "Western Cape", "postalCode": "6603", "addressCountry": "ZA" },
      "sameAs": [{% for url in social_urls %}{% unless forloop.first %},{% endunless %}{{ url | strip | json }}{% endfor %}]
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}" }, "query-input": "required name=search_term_string" }
    }
  ]
}
</script>
