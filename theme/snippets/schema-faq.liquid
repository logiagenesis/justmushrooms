{%- comment -%} Only rendered when the FAQ is visible on the page (faq-accordion renders both). items = array of {question, answer} {%- endcomment -%}
{%- if items and items.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for i in items %}{"@type":"Question","name":{{ i.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ i.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
</script>
{%- endif -%}
