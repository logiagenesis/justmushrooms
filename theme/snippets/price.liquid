{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}">
  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
  <span class="price__current" data-price-current>{{ target.price | money }}</span>
  {%- if on_sale -%}<s class="price__compare"><span class="visually-hidden">{{ 'products.product.price.was' | t }} </span>{{ target.compare_at_price | money }}</s>{%- endif -%}
  {%- if target.unit_price_measurement -%}<span class="price__unit">{{ target.unit_price | money }} / {{ target.unit_price_measurement.reference_value }}{{ target.unit_price_measurement.reference_unit }}</span>{%- endif -%}
</div>
