{%- comment -%} Editorial filler cards used to keep grids balanced. Never a fake product. variant 1..3 cycles. {%- endcomment -%}
{%- assign vv = variant | default: 1 | modulo: 3 -%}
<article class="card card--cta">
  <div class="card__body">
    {%- case vv -%}
      {%- when 1 -%}
        <p class="eyebrow">Not sure where to start?</p>
        <h3 class="card__title">Find your mushroom</h3>
        <p class="card__text">Answer four quick questions about what you want to support. No diagnosis, no promises, just a sensible starting point.</p>
        <div class="card__actions"><a class="btn btn--primary" href="/pages/mushroom-finder">Start the finder</a></div>
      {%- when 2 -%}
        <p class="eyebrow">Species library</p>
        <h3 class="card__title">Read the evidence first</h3>
        <p class="card__text">Every species page shows what the research says, what it does not prove, and who should be cautious.</p>
        <div class="card__actions"><a class="btn btn--secondary" href="/pages/species">Browse species</a></div>
      {%- else -%}
        <p class="eyebrow">Compare</p>
        <h3 class="card__title">Single species or blend?</h3>
        <p class="card__text">See the eight species side by side: form, flavour, evidence tier and safety notes.</p>
        <div class="card__actions"><a class="btn btn--secondary" href="/pages/species#compare">Compare species</a></div>
    {%- endcase -%}
  </div>
</article>
