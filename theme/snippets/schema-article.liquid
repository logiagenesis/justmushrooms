<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "url": "{{ shop.url }}{{ article.url }}",
  {%- if article.image -%}"image": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},{%- endif -%}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Organization", "name": "Just Mushrooms" },
  "publisher": { "@id": "{{ shop.url }}/#organization" },
  "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }}
}
</script>
