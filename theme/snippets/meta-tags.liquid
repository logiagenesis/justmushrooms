{%- comment -%} SEO meta: unique title/description per template with metafield overrides. {%- endcomment -%}
{%- liquid
  assign site_suffix = ' | Just Mushrooms'
  assign default_desc = 'Small-batch functional mushroom tinctures made in Plettenberg Bay, South Africa. Fruit body, dropper, couriered to your door.'
  case request.page_type
    when 'index'
      assign t = 'Functional Mushroom Tinctures South Africa'
      assign d = default_desc
    when 'product'
      assign t = product.metafields.jm.seo_title.value | default: page_title
      assign d = product.metafields.jm.seo_description.value | default: product.metafields.jm.product_promise.value | default: product.description | strip_html | truncate: 155
    when 'collection'
      assign t = collection.title | append: ' — Buy Online in South Africa'
      assign d = collection.description | strip_html | default: default_desc | truncate: 155
    when 'metaobject'
      if metaobject.seo_title.value != blank
        assign t = metaobject.seo_title.value
      else
        assign t = metaobject.common_name.value | append: ' (' | append: metaobject.scientific_name.value | append: ')'
      endif
      assign d = metaobject.seo_description.value | default: metaobject.short_description.value | truncate: 155
    when 'article'
      assign t = article.title
      assign d = article.excerpt_or_content | strip_html | truncate: 155
    when 'page'
      assign t = page.title
      assign d = page.metafields.jm.seo_description.value | default: page.content | strip_html | truncate: 155
      if d == blank
        assign d = default_desc
      endif
    else
      assign t = page_title
      assign d = page_description | default: default_desc
  endcase
  if current_page != 1
    assign t = t | append: ' — Page ' | append: current_page
  endif
  assign t = t | append: site_suffix
  assign og_image = page_image
  if request.page_type == 'index'
    assign og_image = nil
  endif
  if request.page_type == 'metaobject' and metaobject.og_image.value
    assign og_image = metaobject.og_image.value
  endif
-%}
<title>{{ t | escape }}</title>
<meta name="description" content="{{ d | escape }}">
{%- if request.page_type == 'search' or request.page_type == 'cart' or template.suffix == 'test' -%}<meta name="robots" content="noindex,follow">{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ t | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ d | escape }}">
{%- liquid
  assign brand_og = 'https://justmushrooms.co.za/cdn/shop/files/316955697_121928927392695_8890572885037283047_n.jpg?v=1730046342'
  if og_image
    assign og_src = og_image | image_url: width: 1200, height: 630, crop: 'center'
  else
    assign og_src = brand_og
  endif
-%}
<meta property="og:image" content="{{ og_src }}">
<meta property="og:image:secure_url" content="{{ og_src }}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:image" content="{{ og_src }}">
{%- if request.page_type == 'product' -%}
<meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ t | escape }}">
<meta name="twitter:description" content="{{ d | escape }}">
{%- render 'schema-organization' -%}
