{%- comment -%} Usage: render 'schema-breadcrumb', crumbs: array of hashes built in the calling section via 'breadcrumbs' snippet. Here we derive from request. {%- endcomment -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}}
{%- case request.page_type -%}
{%- when 'product' -%}
,{"@type":"ListItem","position":2,"name":"Shop","item":"{{ shop.url }}{{ routes.all_products_collection_url }}"}
,{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":"{{ shop.url }}{{ product.url }}"}
{%- when 'collection' -%}
,{"@type":"ListItem","position":2,"name":"Shop","item":"{{ shop.url }}{{ routes.all_products_collection_url }}"}
{%- unless collection.handle == 'all' -%},{"@type":"ListItem","position":3,"name":{{ collection.title | json }},"item":"{{ shop.url }}{{ collection.url }}"}{%- endunless -%}
{%- when 'metaobject' -%}
,{"@type":"ListItem","position":2,"name":"Species Library","item":"{{ shop.url }}/pages/species"}
,{"@type":"ListItem","position":3,"name":{{ metaobject.common_name.value | json }},"item":"{{ shop.url }}{{ metaobject.system.url }}"}
{%- when 'article' -%}
,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":"{{ shop.url }}{{ blog.url }}"}
,{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":"{{ shop.url }}{{ article.url }}"}
{%- when 'page' -%}
,{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":"{{ shop.url }}{{ page.url }}"}
{%- endcase -%}
]}
</script>
