{%- liquid
  assign species = shop.metaobjects.species.values
-%}
<section class="section" id="finder">
  <div class="page-width">
    <div class="finder reveal" data-finder>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.text }}</p>
      <div class="finder__progress" aria-hidden="true"><i></i><i></i></div>

      <div class="finder__step is-active" data-key="goal">
        <h3 class="h4">What do you want from the bottle?</h3>
        <div class="finder__options">
          <button class="finder__opt" type="button" data-value="focus" aria-pressed="false">Focus for the desk<small>The bottle that lives next to the laptop</small></button>
          <button class="finder__opt" type="button" data-value="energy" aria-pressed="false">Lift for the afternoon<small>When the day still has a second half</small></button>
          <button class="finder__opt" type="button" data-value="calm" aria-pressed="false">The hour the laptop closes<small>Evening, bitter and woody</small></button>
          <button class="finder__opt" type="button" data-value="routine" aria-pressed="false">A daily house blend<small>The dropper people start on and stay on</small></button>
          <button class="finder__opt" type="button" data-value="skin" aria-pressed="false">Skin and morning light<small>Tremella, the beauty-from-within bottle</small></button>
        </div>
      </div>
      <div class="finder__step" data-key="form">
        <h3 class="h4">One mushroom, or a blend?</h3>
        <div class="finder__options">
          <button class="finder__opt" type="button" data-value="single" aria-pressed="false">One species<small>A single dropper. Learn it properly.</small></button>
          <button class="finder__opt" type="button" data-value="blend" aria-pressed="false">A house blend<small>Several mushrooms, one bottle</small></button>
          <button class="finder__opt" type="button" data-value="either" aria-pressed="false">Surprise me<small>Just give me three bottles to look at</small></button>
        </div>
        <button class="btn btn--ghost" type="button" data-finder-back>Back</button>
      </div>

      <div class="finder__result">
        <p class="eyebrow">Your bottles</p>
        <h3 class="h3">Start with these</h3>
        <p class="muted">Three droppers that match what you picked. Open the one that belongs on your counter.</p>
        <ul class="bgrid" data-count="3" data-odd="true" role="list" data-finder-species></ul>
        <div class="btn-row" style="margin-top:1.5rem"><a class="btn btn--primary" href="/collections/all">Shop all tinctures</a><button class="btn btn--ghost" type="button" data-finder-restart>Start again</button></div>
      </div>

      <script type="application/json">
      {
        "rules": {
          "goal": { "focus": ["lions-mane","cordyceps","reishi"], "energy": ["cordyceps","lions-mane","turkey-tail"], "calm": ["reishi","sceletium","lions-mane"], "routine": ["turkey-tail","reishi","chaga"], "skin": ["tremella","reishi","chaga"] },
          "form": { "single": [], "blend": [], "either": [] }
        },
        "species": {
          {%- for s in species -%}
          {{ s.system.handle | json }}: { "name": {{ s.common_name.value | json }}, "sci": {{ s.scientific_name.value | json }}, "url": {{ s.system.url | json }}, "blurb": {{ s.short_description.value | json }}, "product_url": {% if s.linked_products.value.size > 0 %}{{ s.linked_products.value.first.url | json }}{% else %}null{% endif %}, "product_title": {% if s.linked_products.value.size > 0 %}{{ s.linked_products.value.first.title | json }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      }
      </script>
    </div>
  </div>
</section>
<script src="{{ 'finder.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Mushroom Finder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mushroom Finder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the bottle that belongs on your counter." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two short questions. Three tinctures to look at. Then you pick the dropper." }
  ],
  "presets": [ { "name": "Mushroom Finder" } ]
}
{% endschema %}
