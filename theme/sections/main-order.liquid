<section class="section section--tight"><div class="page-width">
  <a class="btn btn--ghost" href="{{ routes.account_url }}">← {{ 'customer.account.return' | t }}</a>
  <h1 class="h2" style="margin-top:1rem">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="muted">{{ 'customer.order.date_html' | t: date: order.created_at | date: '%d %B %Y' }}</p>
  <table class="spec"><thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.sku' | t }}</th><th>{{ 'customer.order.price' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
  <tbody>{%- for line in order.line_items -%}<tr><td><a href="{{ line.product.url }}">{{ line.title }}</a></td><td>{{ line.sku }}</td><td>{{ line.final_price | money }}</td><td>{{ line.quantity }}</td><td>{{ line.final_line_price | money }}</td></tr>{%- endfor -%}</tbody>
  <tfoot><tr><th colspan="4">{{ 'customer.order.subtotal' | t }}</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>{%- for s in order.shipping_methods -%}<tr><th colspan="4">{{ 'customer.order.shipping' | t }} ({{ s.title }})</th><td>{{ s.price | money }}</td></tr>{%- endfor -%}{%- for t in order.tax_lines -%}<tr><th colspan="4">{{ 'customer.order.tax' | t }} ({{ t.title }} {{ t.rate | times: 100 }}%)</th><td>{{ t.price | money }}</td></tr>{%- endfor -%}<tr><th colspan="4">{{ 'customer.order.total' | t }}</th><td><strong>{{ order.total_price | money }}</strong></td></tr></tfoot></table>
  <div class="grid-2" style="margin-top:2rem"><div><h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2><p class="small">{{ order.billing_address | format_address }}</p></div><div><h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2><p class="small">{{ order.shipping_address | format_address }}</p></div></div>
</div></section>
{% schema %}{ "name": "Order", "settings": [] }{% endschema %}
