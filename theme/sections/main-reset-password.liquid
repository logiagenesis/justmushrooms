<section class="section section--tight"><div class="page-width"><div class="auth">
  <h1 class="h2">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label><input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label><input class="input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--primary btn--block" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div></div></section>
{% schema %}{ "name": "Reset password", "settings": [] }{% endschema %}
