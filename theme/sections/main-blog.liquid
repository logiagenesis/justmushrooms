<section class="section section--tight">
  <div class="page-width">
    {%- render 'breadcrumbs' -%}
    <div class="section-header reveal"><div><p class="eyebrow">Learn</p><h1>{{ blog.title }}</h1><p class="lede">{{ section.settings.text }}</p></div></div>
    {%- paginate blog.articles by 12 -%}
      {%- if blog.articles.size > 0 -%}
        {%- render 'balanced-grid', items: blog.articles, card: 'article', fillers: 'auto' -%}
      {%- else -%}
        <p class="notice">{% render 'icon', name: 'info' %} Articles are on the way. Twelve briefs are ready in docs/research/seo-keyword-research.md.</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}<nav class="pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">‹</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a href="{{ paginate.next.url }}">›</a>{% endif %}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Blog", "settings": [ { "type": "textarea", "id": "text", "label": "Intro", "default": "Plain-English guides to functional mushrooms: what they are, how tinctures are made, and how to read the research." } ] }
{% endschema %}
