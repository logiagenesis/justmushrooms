{%- comment -%}
  Reviews render ONLY from a real source: a reviews app block, or the shop metaobject `review` entries (imported from verified orders).
  Nothing is rendered when neither exists. There is no placeholder or sample review anywhere in this theme.
{%- endcomment -%}
{%- assign reviews = shop.metaobjects.review.values -%}
{%- if section.blocks.size > 0 or reviews.size > 0 -%}
<section class="section section--tight">
  <div class="page-width">
    <div class="section-header reveal"><div><p class="eyebrow">From verified orders</p><h2>{{ section.settings.heading }}</h2></div></div>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}{%- render block -%}{%- endfor -%}
    {%- else -%}
      <ul class="bgrid" data-count="{{ reviews.size | at_most: 3 }}" data-odd="{% if reviews.size == 1 or reviews.size == 3 %}true{% else %}false{% endif %}" role="list">
        {%- for r in reviews limit: 3 -%}
          <li><blockquote class="card"><div class="card__body"><p class="card__text" style="-webkit-line-clamp:6">“{{ r.body.value }}”</p><footer class="small muted">{{ r.author.value }}{% if r.verified.value %} · verified order{% endif %}{% if r.product.value %} · {{ r.product.value.title }}{% endif %}</footer></div></blockquote></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Reviews (real only)",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" }, { "type": "paragraph", "content": "This section stays hidden until a reviews app block is added or `review` metaobject entries exist. Never add sample reviews." } ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "Reviews (real only)" } ]
}
{% endschema %}
