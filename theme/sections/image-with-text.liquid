<section class="section section--tight">
  <div class="page-width">
    <div class="iwt{% if section.settings.reverse %} iwt--reverse{% endif %} reveal">
      {%- assign iwt_alt = section.settings.image.alt | default: section.settings.heading -%}
      <div class="iwt__media">{% render 'image', image: section.settings.image, sizes: '(min-width:900px) 50vw, 100vw', alt: iwt_alt %}</div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.cta_label != blank -%}<a class="btn btn--secondary" href="{{ section.settings.cta_url }}" style="margin-top:1rem">{{ section.settings.cta_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (1200×1500)" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How we make it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spring water, ethanol, time" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Our tinctures are made in small batches in Plettenberg Bay using spring water and approximately 30% food-grade ethanol. Each bottle declares its species and its dried-material equivalent per millilitre.</p><p>Sourcing documents, certificates and lab reports are published here as soon as the client supplies them. Until then we make no organic, origin or purity claims.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Our process" },
    { "type": "url", "id": "cta_url", "label": "CTA link", "default": "/pages/sourcing" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
