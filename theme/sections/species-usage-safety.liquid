{%- assign s = metaobject -%}
<section class="section section--tight" id="safety">
  <div class="page-width">
    <div class="grid-2">
      <div class="split__panel reveal">
        <p class="eyebrow">How to use</p>
        <h3 class="h3">Follow the product label</h3>
        <div class="rte">{% if s.how_to_use.value %}{{ s.how_to_use | metafield_tag }}{% else %}<p>Dose and directions are printed on each bottle.</p>{% endif %}</div>
      </div>
      <div class="split__panel split__panel--not reveal">
        <p class="eyebrow">On the label</p>
        <h3 class="h3">Good to know</h3>
        <div class="rte">{{ s.safety_notes | metafield_tag }}</div>
        {%- if s.contraindications.value -%}
        <div class="acc" style="margin-top:1rem">
          <details class="acc__item">
            <summary>Label notes</summary>
            <div class="acc__body rte">{{ s.contraindications | metafield_tag }}</div>
          </details>
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Species: usage and safety", "settings": [], "presets": [ { "name": "Species: usage and safety" } ] }
{% endschema %}
