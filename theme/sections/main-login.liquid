<section class="section section--tight"><div class="page-width"><div class="auth">
  <h1 class="h2">{{ 'customer.login_page.title' | t }}</h1>
  {%- form 'customer_login' -%}
    {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label><input class="input" id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label><input class="input" id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required></div>
    <button class="btn btn--primary btn--block" type="submit">{{ 'customer.login_page.sign_in' | t }}</button>
    <p class="small" style="margin-top:1rem"><a href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a> · <a href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a></p>
  {%- endform -%}
  <details id="recover" style="margin-top:1.5rem"><summary class="btn btn--ghost">{{ 'customer.recover_password.title' | t }}</summary>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}<p class="form-message form-message--success">Check your email for a reset link.</p>{%- endif -%}
      <div class="field" style="margin-top:1rem"><label for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label><input class="input" id="RecoverEmail" type="email" name="email" required></div>
      <button class="btn btn--secondary" type="submit">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </details>
</div></div></section>
{% schema %}{ "name": "Login", "settings": [] }{% endschema %}
