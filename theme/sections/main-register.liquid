<section class="section section--tight"><div class="page-width"><div class="auth">
  <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="RegisterFirst">{{ 'customer.register.first_name' | t }}</label><input class="input" id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="RegisterLast">{{ 'customer.register.last_name' | t }}</label><input class="input" id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="RegisterEmail">{{ 'customer.register.email' | t }}</label><input class="input" id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="RegisterPassword">{{ 'customer.register.password' | t }}</label><input class="input" id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="small" style="display:flex;gap:.6rem;margin-bottom:1rem"><input type="checkbox" id="RegisterMarketing" name="customer[accepts_marketing]"><label for="RegisterMarketing">Email me field notes (POPIA: you can opt out any time)</label></div>
    <button class="btn btn--primary btn--block" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div></div></section>
{% schema %}{ "name": "Register", "settings": [] }{% endschema %}
