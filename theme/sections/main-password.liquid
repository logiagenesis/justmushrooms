<section class="empty page-width">
  <p class="eyebrow">Coming soon</p>
  <h1 class="h2">{{ shop.name }}</h1>
  <p class="lede" style="margin:0 auto 1.5rem">{{ shop.password_message | default: 'The underground is growing. Back shortly.' }}</p>
  <div class="auth">
    {%- form 'storefront_password' -%}
      <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input class="input" type="password" name="password" id="Password" autocomplete="current-password">
      {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      <button class="btn btn--primary btn--block" type="submit" style="margin-top:1rem">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
