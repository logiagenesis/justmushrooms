<section class="section section--tight">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte reveal">{{ section.settings.text }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow column", "default": true }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
