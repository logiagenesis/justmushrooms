<section class="section section--tight"><div class="page-width">
  <a class="btn btn--ghost" href="{{ routes.account_url }}">← {{ 'customer.account.return' | t }}</a>
  <h1 class="h2" style="margin-top:1rem">{{ 'customer.addresses.title' | t }}</h1>
  <details class="split__panel" style="margin-bottom:2rem"><summary class="btn btn--primary">{{ 'customer.addresses.add_new' | t }}</summary>
    {%- form 'customer_address', customer.new_address -%}{%- render 'address-fields', form: form, id: 'new' -%}<button class="btn btn--primary" type="submit">{{ 'customer.addresses.add' | t }}</button>{%- endform -%}
  </details>
  {%- paginate customer.addresses by 10 -%}
  <div class="grid-2">
  {%- for address in customer.addresses -%}
    <div class="split__panel">
      {%- if address == customer.default_address -%}<span class="badge">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
      <p class="small">{{ address | format_address }}</p>
      <details><summary class="btn btn--ghost">{{ 'customer.addresses.edit' | t }}</summary>
        {%- form 'customer_address', address -%}{%- render 'address-fields', form: form, id: address.id -%}<button class="btn btn--primary" type="submit">{{ 'customer.addresses.update' | t }}</button>{%- endform -%}
      </details>
      {%- form 'customer_address', address -%}{%- endform -%}
      <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" onsubmit="return confirm({{ 'customer.addresses.delete_confirm' | t | json }})"><input type="hidden" name="_method" value="delete"><button class="btn btn--ghost small" type="submit">{{ 'customer.addresses.delete' | t }}</button></form>
    </div>
  {%- endfor -%}
  </div>
  {%- endpaginate -%}
</div></section>
{% schema %}{ "name": "Addresses", "settings": [] }{% endschema %}
