<section class="section section--tight">
  <div class="page-width">
    <div class="finder reveal" style="display:grid;grid-template-columns:1.3fr 1fr;gap:2rem;align-items:center">
      <div>
        <p class="eyebrow">Mushroom Finder</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.text }}</p>
        <a class="btn btn--primary btn--lg" href="/pages/mushroom-finder" onclick="JM.track('mushroom_finder_start',{source:'home_teaser'})">Find your bottle</a>
      </div>
      <ul class="tier-list" aria-label="How it works">
        <li><span class="badge">1</span><span>Say what you want from the morning</span></li>
        <li><span class="badge">2</span><span>One mushroom or a house blend</span></li>
        <li><span class="badge">3</span><span>Three bottles. Pick the dropper.</span></li>
      </ul>
    </div>
  </div>
</section>
<style>@media (max-width:900px){#shopify-section-{{ section.id }} .finder{grid-template-columns:1fr!important}}</style>
{% schema %}
{
  "name": "Finder teaser",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which bottle is yours?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two short questions. Three tinctures. Then you pick the dropper that belongs on your counter." }
  ],
  "presets": [ { "name": "Finder teaser" } ]
}
{% endschema %}
