<section class="section section--tight">
  <div class="page-width">
    <div class="finder reveal" style="display:grid;grid-template-columns:1.3fr 1fr;gap:2rem;align-items:center">
      <div>
        <p class="eyebrow">Mushroom Finder</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="lede">{{ section.settings.text }}</p>
        <a class="btn btn--primary btn--lg" href="/pages/mushroom-finder" onclick="JM.track('mushroom_finder_start',{source:'home_teaser'})">Start the finder</a>
      </div>
      <ul class="tier-list" aria-label="How it works">
        <li><span class="badge">1</span><span>Pick what you want to support</span></li>
        <li><span class="badge">2</span><span>Single species or blend</span></li>
        <li><span class="badge">3</span><span>How much the research matters to you</span></li>
        <li><span class="badge">4</span><span>Get three species pages to read, with safety notes first</span></li>
      </ul>
    </div>
  </div>
</section>
<style>@media (max-width:900px){#shopify-section-{{ section.id }} .finder{grid-template-columns:1fr!important}}</style>
{% schema %}
{
  "name": "Finder teaser",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure where to start?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Four quick questions. No diagnosis, no medical promises, just a sensible reading list and the products that match." }
  ],
  "presets": [ { "name": "Finder teaser" } ]
}
{% endschema %}
