{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.limit | default: 6
  assign items = coll.products
  if items.size == 0
    assign items = collections.all.products
  endif
-%}
<section class="section section--tight" id="shop-featured">
  <div class="page-width">
    <div class="section-header reveal">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <a class="btn btn--secondary" href="{{ coll.url | default: routes.all_products_collection_url }}">Shop all {% render 'icon', name: 'arrow' %}</a>
    </div>
    {%- render 'balanced-grid', items: items, card: 'product', max: limit, list_name: 'home_featured' -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (curate to 6 or 8 products for a 3+3 / 4+4 grid)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tinctures, priced plainly" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Live prices and stock straight from our store. VAT included." },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [ { "name": "Featured products" } ]
}
{% endschema %}
