<section class="hero hero--compact">
  <div class="hero__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '900,1200,1600,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt | default: page.title }}{% else %}<div style="width:100%;height:100%;background:radial-gradient(ellipse at 70% 30%,rgba(47,93,70,.5),transparent 55%),var(--c-ink)"></div>{% endif %}</div>
  <div class="hero__scrim"></div>
  <div class="page-width hero__content">
    {%- render 'breadcrumbs' -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to page title)" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
